# Local node state. A node's identity and log are PRIVATE to that node —
# never commit them, never share them.
.node/
.tmp/
*.node/

# Wrangler dev artifacts (generated by tools/verify-worker-local.ps1)
worker/wrangler.dev.toml
worker/wrangler.dev.log
worker/wrangler.dev.err

# Wrangler's own local state and build output
worker/.wrangler/
worker/.dev.vars

# Node
node_modules/
npm-debug.log*

# private administrative keys - never commit
.keys/

# A node's identity file IS a private key: it carries a `privateKey` field, so
# committing one publishes the ability to speak as that key. Match it by NAME at
# ANY depth. The directory-scoped rules above were not enough — they missed
# .demo/, which the demo runs fill with alice/bob/mallory keypairs.
identity.json
*.identity.json

# Demo scratch runs. Same class of debris as .tmp/, and equally disposable.
.demo/

# Generic secret shapes, so a future file does not need a new rule to be safe.
*.pem
.env
.env.*
